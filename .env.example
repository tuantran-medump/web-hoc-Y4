# ==============================================================================
# WEB HỌC Y4 — Biến môi trường mẫu (.env.example)
# ⚠️ Quy tắc 🔒: Agent KHÔNG tự điền secret thật. Nếu thiếu biến môi trường,
# hệ thống tự động fallback sang Memory/IndexedDB Adapter để chạy dev & test.
# ==============================================================================

# 1. Supabase (Postgres + Storage cho đề thi, bài làm, ảnh đề)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Google Drive Service Account (Chỉ quyền đọc 1 thư mục tài liệu Y4)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=
